###############################################################################
# Normalize line endings. Adapted from mzLib.
###############################################################################
* text=auto

*.cs      text diff=csharp
*.py      text
*.md      text
*.yml     text
*.yaml    text
*.ps1     text
*.csproj  text
*.json    text
*.cff     text

###############################################################################
# Binary
###############################################################################
*.png  binary
*.jpg  binary
*.whl  binary
*.exe  binary
*.dll  binary
*.raw  binary
*.msl  binary

###############################################################################
# Byte-exact fixtures: their sha256 is part of what the tests pin, so a CRLF
# checkout on Windows must not change them.
###############################################################################
pkg/python/tests/fixtures/proteins/** -text
pkg/python/tests/fixtures/orthology/** -text
pkg/python/tests/fixtures/map_residues/** -text
