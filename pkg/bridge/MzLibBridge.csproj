<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mzlib-bridge</AssemblyName>
    <RootNamespace>MzLibBridge</RootNamespace>
    <!-- `Platforms` names the solution configuration, which must stay x64 to match the mzLib
         projects this references. PlatformTarget is deliberately NOT pinned here: it has to
         follow the RuntimeIdentifier, or an arm64 publish fails with NETSDK1032 because the
         inherited x64 target contradicts the RID. publish-bridge.ps1 sets it per runtime. -->
    <Platforms>x64</Platforms>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Self-contained single-file publish is what gets staged into the Python wheel;
         the user must never install a .NET runtime (decision D2). -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The argument parser and the wire-shaping helpers are internal, not public API: they are
         implementation details of a command-line tool. The test project needs to see them. -->
    <InternalsVisibleTo Include="MzLibBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sourced from the pinned mzLib worktree under code/mzLib (see code/PINNED.md).
         Deliberately references the narrowest project that carries PrideArchiveClient rather
         than the whole mzLib NuGet package, which drags TorchSharp/libtorch and native
         vendor DLLs — see smith-chem-wisc/mzLib#1103. -->
    <ProjectReference Include="..\..\code\mzLib\mzLib\UsefulProteomicsDatabases\UsefulProteomicsDatabases.csproj" />
    <ProjectReference Include="..\..\code\mzLib\mzLib\Proteomics\Proteomics.csproj" />
    <ProjectReference Include="..\..\code\mzLib\mzLib\Omics\Omics.csproj" />
    <ProjectReference Include="..\..\code\mzLib\mzLib\MassSpectrometry\MassSpectrometry.csproj" />
    <!-- FlashLFQ carries the label-free quant engine AND the MakeIdentifications extension that
         turns a Readers result file into FlashLFQ inputs; it transitively brings Readers and
         MassSpectrometry. This is the narrowest seam that lets the bridge do quant with mzLib
         alone (no MetaMorpheus). See design/expansion-plans/flashlfq-tranche.md. -->
    <ProjectReference Include="..\..\code\mzLib\mzLib\FlashLFQ\FlashLFQ.csproj" />
  </ItemGroup>

  <!-- libtorch arrives through Proteomics -> Chromatography, which references libtorch-cpu for the
       Chronologer retention-time predictor. No bridge verb reaches Chronologer, yet its native
       libraries were ~110 MiB of the Linux wheel and put three of the four wheels over PyPI's
       100 MiB file limit. This drops only the native libraries: TorchSharp's managed assembly stays,
       so everything compiles and loads, and only an actual call into torch would fail. If a torch
       verb is ever added, libtorch becomes an on-demand download rather than returning to the
       payload (bridge decision BRIDGE-PAYLOAD-NO-LIBTORCH). -->
  <Target Name="DropLibtorchNatives" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_LibtorchNative Include="@(NativeCopyLocalItems)" Condition="$([System.String]::new('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('libtorch'))" />
      <_LibtorchRuntimeTarget Include="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::new('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('libtorch'))" />
      <NativeCopyLocalItems Remove="@(_LibtorchNative)" />
      <RuntimeTargetsCopyLocalItems Remove="@(_LibtorchRuntimeTarget)" />
    </ItemGroup>
  </Target>

  <!-- Thermo's RawFileReader cannot run from inside a single-file bundle: RawFileReaderAdapter
       locates its own implementation on disk, so when the ThermoFisher.CommonCore assemblies are
       packed into mzlib-bridge they are not there and every .raw read fails with "Method invocation
       failed on Method[ThreadedFileFactory]". Publishing them as loose files beside the executable
       fixes it; the rest of the bridge stays single-file. -->
  <Target Name="KeepThermoOutOfSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::new('%(ResolvedFileToPublish.Filename)').StartsWith('ThermoFisher.CommonCore'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- The `version` verb reports every verb this bridge dispatches, and the unknown-command error
       lists them. Both come from Program.Verbs, which is GENERATED here from the keys of the
       DispatchAsync switch in Program.cs, so there is no second, hand-kept list to forget: adding
       an arm to the switch is the whole of registering a verb (bridge design/BULK.md section 5).
       The pattern is the one bridge/tools/check_verbs.py uses to find the verbs a spec must exist
       for, so the two readers of that switch cannot disagree about what is in it. -->
  <UsingTask TaskName="DeriveVerbList" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string text = File.ReadAllText(Source);
        int start = text.IndexOf("return arguments.Verb switch", StringComparison.Ordinal);
        int end = start < 0 ? -1 : text.IndexOf("_ =>", start, StringComparison.Ordinal);
        if (start < 0 || end < 0)
        {
            Log.LogError("DeriveVerbList: no 'return arguments.Verb switch' ... '_ =>' in " + Source);
            return false;
        }
        string[] verbs = Regex.Matches(text.Substring(start, end - start), "^\\s*\"([^\"]+)\"\\s*=>", RegexOptions.Multiline)
            .Cast<Match>().Select(m => m.Groups[1].Value).ToArray();
        string generated =
            "// <auto-generated>From the DispatchAsync switch in Program.cs by the DeriveVerbList target in MzLibBridge.csproj. Do not edit.</auto-generated>\n" +
            "namespace MzLibBridge;\n\n" +
            "public static partial class Program\n{\n" +
            "    /// <summary>Every verb DispatchAsync routes, in switch order. Generated from the switch itself.</summary>\n" +
            "    internal static readonly System.Collections.Generic.IReadOnlyList<string> Verbs = new[]\n    {\n" +
            string.Concat(verbs.Select(v => "        \"" + v + "\",\n")) +
            "    };\n}\n";
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != generated)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(Destination));
            File.WriteAllText(Destination, generated);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateVerbList" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_VerbListFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Verbs.g.cs'))</_VerbListFile>
    </PropertyGroup>
    <DeriveVerbList Source="$(MSBuildProjectDirectory)/Program.cs"
                    Destination="$(_VerbListFile)" />
    <ItemGroup>
      <Compile Include="$(_VerbListFile)"
               Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>
